# Copia este archivo a .env y rellena los valores. .env NO se sube a git.

# Connection string de Neon Postgres (Console -> Connect).
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Secreto de Auth.js. Genera uno con: npx auth secret
AUTH_SECRET="reemplaza-con-un-secreto-aleatorio"

# URL pública del sitio (para el código QR de difusión).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PIN de 4 dígitos del administrador. Solo se usa al sembrar (npm run db:seed).
# Ponlo aquí, ejecuta el seed y quedará aplicado. NO se sube a git.
ADMIN_PIN="0000"
